{
  "name": "ng-a11y",
  "version": "0.0.13",
  "description": "Angular.js Accessibility Module",
  "main": "dist/nga11y.min.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "karma start karma.conf.js --single-run",
    "test:watch": "karma start karma.conf.js",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build && npm test",
    "demo": "npx --yes http-server . -c-1 -o /examples/",
    "test:e2e": "node --test \"e2e/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dequelabs/ngA11y.git"
  },
  "keywords": [
    "Angular",
    "AngularJS",
    "Accessibility",
    "a11y"
  ],
  "author": "Dylan Barrell & Ian Kelly",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dequelabs/ngA11y/issues"
  },
  "homepage": "https://github.com/dequelabs/ngA11y",
  "devDependencies": {
    "angular": "^1.8.3",
    "angular-mocks": "^1.8.3",
    "axe-core": "^4.10.0",
    "jasmine-core": "^5.0.0",
    "jquery": "^3.7.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-spec-reporter": "^0.0.36",
    "terser": "^5.31.0",
    "puppeteer-core": "^24.0.0",
    "chrome-launcher": "^1.1.2"
  },
  "files": [
    "src",
    "dist"
  ],
  "peerDependencies": {
    "angular": ">=1.2.0"
  }
}
